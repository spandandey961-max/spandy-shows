# Spandy Shows private local Compose configuration. No secrets are included.
SPANDY_DB_PASSWORD=replace-with-your-own-local-password
# Absolute directory ON THE DOCKER HOST, created before compose starts.
# Linux example: /absolute/path/spandy-shows/jobs
# Docker Desktop accepts forward slashes, e.g. C:/Projects/spandy-shows/jobs
SPANDY_JOB_HOST_ROOT=/absolute/path/spandy-shows/jobs
SPANDY_EXECUTION_MODE=docker
SPANDY_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SPANDY_HOSTS=127.0.0.1,localhost
